{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on Monday"],
  "timezone": "Europe/Berlin",
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Automerge patch bumps",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Group and automerge Radix UI — all components, safe minor/patch",
      "matchPackagePatterns": ["^@radix-ui/"],
      "groupName": "Radix UI",
      "automerge": true
    },
    {
      "description": "Group Vercel observability packages",
      "matchPackagePatterns": ["^@vercel/"],
      "groupName": "Vercel",
      "automerge": true
    },
    {
      "description": "Group tRPC — client, server, react-query, next must move together",
      "matchPackagePatterns": ["^@trpc/"],
      "groupName": "tRPC"
    },
    {
      "description": "Group TanStack — react-query major must align with tRPC",
      "matchPackagePatterns": ["^@tanstack/"],
      "groupName": "TanStack"
    },
    {
      "description": "Group Drizzle — orm, kit, and auth adapter must move together",
      "matchPackageNames": ["drizzle-orm", "drizzle-kit", "@auth/drizzle-adapter"],
      "groupName": "Drizzle"
    },
    {
      "description": "Group testing toolchain — vitest, jsdom, plugin-react must stay in sync",
      "matchPackageNames": ["vitest", "jsdom", "@vitejs/plugin-react"],
      "matchPackagePatterns": ["^@vitest/", "^@playwright/", "^@testing-library/"],
      "groupName": "testing"
    },
    {
      "description": "Group ESLint — flat config migration required for v9+",
      "matchPackageNames": ["eslint", "eslint-config-prettier", "eslint-config-next"],
      "matchPackagePatterns": ["^@typescript-eslint/"],
      "groupName": "ESLint"
    },
    {
      "description": "Group React and Next.js — must be upgraded together",
      "matchPackageNames": [
        "react",
        "react-dom",
        "next",
        "@types/react",
        "@types/react-dom",
        "eslint-config-next"
      ],
      "groupName": "React / Next.js"
    },
    {
      "description": "Hold back major upgrades that require coordinated migrations",
      "matchUpdateTypes": ["major"],
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "tailwindcss",
        "prettier-plugin-tailwindcss",
        "tailwind-merge",
        "typescript",
        "nodemailer",
        "@neondatabase/serverless",
        "eslint",
        "eslint-config-next"
      ],
      "matchPackagePatterns": ["^@typescript-eslint/"],
      "enabled": false
    }
  ]
}
