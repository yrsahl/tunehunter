    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.30.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^10",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^17",
    "mysql2": "^3.22.3",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "ct3aMetadata": {
    "initVersion": "7.27.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "vitest related --run"
    ]
  }
}
