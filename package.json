{
  "name": "tunehunter",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build",
    "postbuild": "next-sitemap",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:dev": "NODE_ENV=development drizzle-kit migrate",
    "db:migrate:prod": "NODE_ENV=production drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "dev:quiet": "next dev 2>&1 | grep -vE '^[[:space:]]*(GET|POST|PUT|PATCH|DELETE|OPTIONS|HEAD) /'",
    "lint": "next lint",
    "start": "next start",
    "test:unit:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:full": "playwright test --grep @full",
    "stress:baseline": "k6 run -e STRESS_PROFILE=baseline scripts/stress/tunehunter.k6.js",
    "stress:spike": "k6 run -e STRESS_PROFILE=spike scripts/stress/tunehunter.k6.js",
    "stress:soak": "k6 run -e STRESS_PROFILE=soak scripts/stress/tunehunter.k6.js",
    "stress:vendor-probe": "k6 run -e STRESS_PROFILE=vendor_probe scripts/stress/tunehunter.k6.js",
    "stress:trpc-rl": "bun run scripts/stress/trpc-rate-limit-drill.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^0.7.0",
    "@hookform/resolvers": "^3.10.0",
    "@neondatabase/serverless": "^0.9.5",
    "@planetscale/database": "^1.20.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rapideditor/country-coder": "^5.6.1",
    "@t3-oss/env-nextjs": "^0.9.2",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tanstack/react-query": "^5.100.10",
    "@trpc/client": "^11.17.0",
    "@trpc/next": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@types/cheerio": "^1.0.0",
    "@uidotdev/usehooks": "^2.4.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.38.4",
    "embla-carousel-react": "^8.6.0",
    "events": "^3.3.0",
    "input-otp": "^1.4.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1",
    "motion": "^12.38.0",
    "next": "14.2.35",
    "next-auth": "^4.24.14",
    "next-seo": "^6.8.0",
    "next-themes": "^0.4",
    "nodemailer": "^6.10.1",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "react-spinners": "^0.17",
    "resend": "^4.8.0",
    "sonner": "^2",
    "spotify-preview-finder": "^2.1.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
